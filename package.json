{
  "name": "pomelo",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev:api": "node --watch server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "build": "cd client && npm install && npm run build",
    "start": "node server.js",
    "ingest": "node scripts/ingest.js",
    "ingest:resume": "node scripts/ingest.js --resume",
    "price": "node scripts/price.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Pomelo — AI-powered stock discovery engine",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "axios": "^1.17.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
