# StockScout is pure BYOK (bring your own key): API keys are entered in the
# app's Settings panel, stored in the browser, and sent per-request. The server
# does NOT use any keys from this file — it only reads PORT.
#
# Users provide their own:
#   - Finnhub key  (live pricing, free 60/min)  → https://finnhub.io/register
#   - Anthropic key (Claude deep-dives)         → https://console.anthropic.com
#   - FMP key       (optional pricing fallback) → financialmodelingprep.com

PORT=3001
